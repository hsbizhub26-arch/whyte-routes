rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Owners of WHYTE ROUTES itself. Enforced here (not just
    // in app code) so nobody can grant themselves platform access by
    // writing to Firestore directly. Deliberately a small, fixed list -
    // company-level roles are all data-driven (see below), only this
    // platform tier is hardcoded.
    function isPlatformAdminUID(uid) {
      return uid in [
        'x5cxMZN5TKTXcIwrVMAPmQJOp3R2', // teamdwlandscaping@gmail.com
        'bMeTRuhikKVlCU6rE8QFBp0TXAz1'  // hopeseneoudom@icloud.com
      ];
    }

    function myPermissions() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True if the *requesting* user's own permissions doc has
    // platformAdmin == true (i.e. they're a real, provisioned platform
    // admin - distinct from isPlatformAdminUID, which is only used to
    // bootstrap that first document).
    function isPlatformAdmin() {
      return isSignedIn() && myPermissions().platformAdmin == true;
    }

    function myCompanyId() {
      return myPermissions().companyId;
    }

    function myCompanyRole() {
      return myPermissions().companyRole;
    }

    // Signed in, belongs to companyId, and holds companyRole owner or manager.
    function isCompanyStaff(companyId) {
      return isSignedIn() && myCompanyId() == companyId
        && (myCompanyRole() == 'owner' || myCompanyRole() == 'manager');
    }

    // Any signed-in member of this company at all (owner/manager/driver).
    function isCompanyMember(companyId) {
      return isSignedIn() && myCompanyId() == companyId;
    }

    // Specifically the owner (not manager) of this company - used for
    // owner-only actions like inviting/removing employees.
    function isCompanyOwnerRole(companyId) {
      return isCompanyMember(companyId) && myCompanyRole() == 'owner';
    }

    // True if the signed-in requester's own verified email or phone
    // number (from their Firebase Auth token, not from Firestore data
    // they could otherwise influence) matches this invite document's ID.
    // Used so a person can only ever look up/accept the one invite that
    // was actually sent to them - never anyone else's.
    function isInviteRecipient(contactValue) {
      return isSignedIn() && (
        (('email' in request.auth.token) && request.auth.token.email.lower() == contactValue)
        || (('phone_number' in request.auth.token) && request.auth.token.phone_number == contactValue)
      );
    }

    function canAccessCompany(companyId) {
      return isPlatformAdmin() || isCompanyMember(companyId);
    }

    // True if the requester is the driver assigned to this specific
    // stop - looked up via the stop doc itself (not trusted from the
    // request), since photos/notifications are separate subcollections
    // with their own independent rules that don't automatically
    // inherit a restriction placed on the parent stop.
    function isAssignedStopDriver(companyId, routeId, stopId) {
      return isCompanyMember(companyId)
        && get(/databases/$(database)/documents/companies/$(companyId)/routes/$(routeId)/stops/$(stopId)).data.driverId == request.auth.uid;
    }

    // True if a still-PENDING invite exists, addressed to this
    // requester's own verified email or phone, for exactly this
    // companyId/role. Lets a self-created users/{uid} document set
    // companyId/companyRole at creation time without that being a
    // self-granted privilege - the invite is proof someone's company
    // owner already granted it. Checked against 'pending' (not
    // 'accepted') specifically because the app writes users/{uid}
    // BEFORE marking the invite consumed, so this can never be
    // satisfied twice by the same invite.
    function usableInviteMatches(companyId, role) {
      return
        (('email' in request.auth.token)
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.companyId == companyId
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role == role
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.status == 'pending')
        ||
        (('phone_number' in request.auth.token)
          && exists(/databases/$(database)/documents/invites/$(request.auth.token.phone_number))
          && get(/databases/$(database)/documents/invites/$(request.auth.token.phone_number)).data.companyId == companyId
          && get(/databases/$(database)/documents/invites/$(request.auth.token.phone_number)).data.role == role
          && get(/databases/$(database)/documents/invites/$(request.auth.token.phone_number)).data.status == 'pending');
    }

    // ── users/{uid} — role + company membership + subscription ─────
    // Every signed-in user may read/create only their own document.
    // Creating with platformAdmin: true is only allowed for the two
    // platform-owner UIDs; everyone else is blocked from ever setting
    // platformAdmin, isAdmin, or role "owner" on themselves. Regular
    // users may not set their own companyId/companyRole either -
    // company membership is assigned by a platform admin or that
    // company's owner (see update rule), never claimed by self-create,
    // so nobody can invent membership in a company they don't belong to.
    //
    // Updates: a platform admin may update any user's document. A
    // company's owner may update company membership fields for users
    // within their own company (adding/removing employees). Everyone
    // else may only update their own document, and never role,
    // isAdmin, platformAdmin, subscription, companyId, or companyRole.

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId
                    && (
                         (isPlatformAdminUID(userId)
                           && request.resource.data.role == 'owner'
                           && request.resource.data.isAdmin == true
                           && request.resource.data.platformAdmin == true)
                         ||
                         (!isPlatformAdminUID(userId)
                           && request.resource.data.role != 'owner'
                           && request.resource.data.isAdmin == false
                           && (!('platformAdmin' in request.resource.data) || request.resource.data.platformAdmin == false)
                           && !('companyId' in request.resource.data)
                           && !('companyRole' in request.resource.data))
                         ||
                         // Accepting a real invite: companyId/companyRole
                         // ARE present, but only allowed when they match
                         // a pending invite addressed to this account's
                         // own verified identity - not self-granted.
                         (!isPlatformAdminUID(userId)
                           && request.resource.data.role != 'owner'
                           && request.resource.data.isAdmin == false
                           && (!('platformAdmin' in request.resource.data) || request.resource.data.platformAdmin == false)
                           && request.resource.data.companyId is string
                           && request.resource.data.companyRole is string
                           && usableInviteMatches(request.resource.data.companyId, request.resource.data.companyRole))
                         ||
                         // Self-serve signup with no invite waiting: becomes
                         // a "pending owner" with role owner but no company
                         // yet - owning zero companies grants no actual
                         // access anywhere, so this is safe. The only way
                         // to attach a real companyId/companyRole after
                         // this is the update rule below, which requires
                         // proof they actually own a real company doc.
                         (!isPlatformAdminUID(userId)
                           && request.resource.data.role == 'owner'
                           && request.resource.data.isAdmin == false
                           && (!('platformAdmin' in request.resource.data) || request.resource.data.platformAdmin == false)
                           && !('companyId' in request.resource.data)
                           && !('companyRole' in request.resource.data))
                       );

      allow update: if isSignedIn() && (
                         isPlatformAdmin()
                         ||
                         // Company owner managing one of their own
                         // employees' membership/role within the company.
                         (resource.data.companyId is string
                           && isCompanyStaff(resource.data.companyId)
                           && myCompanyRole() == 'owner'
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.isAdmin == resource.data.isAdmin
                           && request.resource.data.platformAdmin == resource.data.platformAdmin
                           && request.resource.data.subscription == resource.data.subscription)
                         ||
                         // Self-update: everything except the
                         // privileged/membership fields, which are frozen.
                         (request.auth.uid == userId
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.isAdmin == resource.data.isAdmin
                           && request.resource.data.platformAdmin == resource.data.platformAdmin
                           && request.resource.data.subscription == resource.data.subscription
                           && request.resource.data.companyId == resource.data.companyId
                           && request.resource.data.companyRole == resource.data.companyRole)
                         ||
                         // Claiming ownership of a company just created via
                         // self-serve signup - the one-time transition from
                         // "pending owner, no company" to "owner of a real
                         // company." Proven by the company doc's own
                         // ownerUID, set at creation time and never
                         // touchable afterward (see companies/{id} create
                         // rule) - not self-asserted here.
                         (request.auth.uid == userId
                           && resource.data.role == 'owner'
                           && !('companyId' in resource.data)
                           && request.resource.data.companyId is string
                           && request.resource.data.companyRole == 'owner'
                           && get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.ownerUID == request.auth.uid
                           && request.resource.data.role == resource.data.role
                           && request.resource.data.isAdmin == resource.data.isAdmin
                           && request.resource.data.platformAdmin == resource.data.platformAdmin
                           && request.resource.data.subscription == resource.data.subscription)
                         ||
                         // Self-heal for the two hardcoded platform-admin
                         // bootstrap accounts only (see isPlatformAdminUID) -
                         // lets AuthSession's backfill correct a doc that
                         // was created before platformAdmin/role/isAdmin
                         // existed as fields. Without this, that backfill
                         // is a chicken-and-egg rejection: the plain self-
                         // update branch above freezes exactly these three
                         // fields, and the isPlatformAdmin() bypass can't
                         // apply either, since the doc doesn't have
                         // platformAdmin: true set until after this write
                         // succeeds. Values match the create rule's own
                         // bootstrap branch exactly; every other field
                         // (subscription/companyId/companyRole) still
                         // stays frozen, so this can't be combined to
                         // sneak through an unrelated change.
                         (request.auth.uid == userId
                           && isPlatformAdminUID(userId)
                           && request.resource.data.role == 'owner'
                           && request.resource.data.isAdmin == true
                           && request.resource.data.platformAdmin == true
                           && request.resource.data.subscription == resource.data.subscription
                           && request.resource.data.companyId == resource.data.companyId
                           && request.resource.data.companyRole == resource.data.companyRole)
                       );
    }

    // ── companies/{companyId} ────────────────────────────────
    // Any member of a company can read their own company's record
    // (so the app can show plan/tier info); platform admins can read
    // any company. Creating/editing companies (onboarding, changing
    // subscription tier/status) is a platform-admin action for now -
    // TODO(self-serve signup / Phase 6): allow a company's own owner
    // to update other non-billing fields (e.g. name) once a self-serve
    // onboarding flow exists. navigationSettings is the first
    // narrow exception: a company owner may update ONLY that field on
    // their own company - checked via affectedKeys() so this can never
    // be used to touch name/subscriptionTier/billingRequired/ownerUID.

    match /companies/{companyId} {
      allow read: if canAccessCompany(companyId);
      // Self-serve creation: any signed-in user can create a company
      // naming themselves as ownerUID, but only on the free starter
      // tier with billing left on - a self-service signup can never
      // grant itself a paid tier or a comped/no-billing account for
      // free. Upgrading past starter goes through the real StoreKit
      // paywall (see SubscriptionTierView), which is the only path
      // that can raise subscriptionTier afterward (still platform-
      // admin/Cloud-Function-only on update, below).
      allow create: if isPlatformAdmin()
                    || (isSignedIn()
                         && request.resource.data.ownerUID == request.auth.uid
                         && request.resource.data.subscriptionTier == 'starter'
                         && request.resource.data.billingRequired == true);
      allow delete: if isPlatformAdmin();
      allow update: if isPlatformAdmin()
                    || (isCompanyOwnerRole(companyId)
                         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['navigationSettings', 'quietHoursEnabled']));

      // ── companies/{companyId}/drivers/{driverId} ─────────
      // Contains PII (name, phone) alongside location - authenticated
      // company staff only, never public. (See CustomerTrackingView.swift
      // for why customer tracking does NOT read this collection.)
      match /drivers/{driverId} {
        // A plain driver may read only their own record - staff need
        // every driver's location/contact info for the fleet map, but
        // a driver has no legitimate reason to read another driver's
        // phone number, live GPS, or license photo path, and nothing
        // in the app's own UI ever asks for that. This mirrors the
        // create/update rules just below, which already drew this
        // same line - read was the one left too broad.
        allow read: if isCompanyStaff(companyId)
                    || (isCompanyMember(companyId) && request.auth.uid == driverId);
        // A driver's own record is created/updated by themselves on
        // first sign-in and while working (name, GPS, shift status) -
        // but only the ONE doc whose ID is their own uid, never any
        // other driver's. Staff can manage any driver record.
        allow create: if isCompanyStaff(companyId)
                      || (isCompanyMember(companyId) && request.auth.uid == driverId);
        allow update: if isCompanyStaff(companyId)
                      || (isCompanyMember(companyId) && request.auth.uid == driverId);
        allow delete: if isCompanyStaff(companyId);

        // ── companies/{companyId}/drivers/{driverId}/shifts/{shiftId} ─
        // Clock-in/clock-out records. A driver logs only their own
        // (driverId's own uid must match the parent drivers/{driverId}
        // doc they're nested under); staff can read for hours/payroll
        // reporting but never edit a driver's own logged time.
        match /shifts/{shiftId} {
          allow read: if isCompanyStaff(companyId)
                      || (isCompanyMember(companyId) && request.auth.uid == driverId);
          allow create, update: if isCompanyMember(companyId) && request.auth.uid == driverId;
          allow delete: if isCompanyStaff(companyId);
        }
      }

      // ── companies/{companyId}/customers/{customerId} ─────
      // Customer PII - staff only. Customers never sign in themselves.
      match /customers/{customerId} {
        allow read, write: if isCompanyStaff(companyId);
      }

      // ── companies/{companyId}/routes/{routeId} + stops ───
      match /routes/{routeId} {
        allow read: if isCompanyMember(companyId);
        allow create, delete: if isCompanyStaff(companyId);
        // Staff can change anything (name, driver assignment, etc.).
        // The route's own assigned driver may update ONLY status/
        // updatedAt, nothing else - specifically for
        // RouteRepository.updateStatus, called when a driver finishes
        // their last stop to mark the whole route completed (so a
        // later "fetch my current route" query, which excludes
        // status == completed, doesn't keep matching a finished
        // route). Without this branch, that write was silently
        // rejected for every real driver account - it only ever
        // looked like it worked when tested through an owner's own
        // "I also drive routes" session, which passes isCompanyStaff
        // regardless.
        allow update: if isCompanyStaff(companyId)
                      || (isCompanyMember(companyId)
                           && resource.data.driverId == request.auth.uid
                           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));

        // Driver login is now tied to a real Firebase Auth UID (see
        // AuthSession.bridgeDriverSession), so a driver can write only
        // the stop already assigned to them (resource.data.driverId
        // matches their own uid) - staff can write any stop. Stops are
        // always created by staff building a route, never by a driver,
        // so create requires isCompanyStaff (resource doesn't exist
        // yet on create, so the driver branch can't match).
        match /stops/{stopId} {
          // Same tightening as drivers/{driverId} above, mirroring
          // the write rule directly below: a driver reads only stops
          // actually assigned to them, not every customer's name/
          // phone/email/address/notes company-wide. The app's own
          // DriverSession only ever queries a driver's own assigned
          // route anyway - this just makes that the enforced boundary,
          // not just the app's good behavior.
          allow read: if isCompanyStaff(companyId)
                      || (isCompanyMember(companyId) && resource.data.driverId == request.auth.uid);
          allow write: if isCompanyStaff(companyId)
                       || (isCompanyMember(companyId) && resource.data.driverId == request.auth.uid);

          // ── .../stops/{stopId}/photos/{photoId} ─────────
          // Proof-of-work photo metadata (the actual image lives in
          // Firebase Storage - see storage.rules). Staff read any;
          // a driver only their own assigned stop's - closes the same
          // gap as stops/{stopId} above, since this subcollection has
          // its own rule that wouldn't otherwise inherit that
          // restriction. Create stays open to any company member
          // (drivers uploading); only staff edit/delete.
          match /photos/{photoId} {
            allow read: if isCompanyStaff(companyId) || isAssignedStopDriver(companyId, routeId, stopId);
            allow create: if isCompanyMember(companyId);
            allow update, delete: if isCompanyStaff(companyId);
          }

          // ── .../stops/{stopId}/notifications/{notificationId} ──
          // Timestamped log of customer notifications - the proof an
          // owner points to in a "you never told me" dispute. Same
          // read tightening as photos just above. Create stays open
          // to any company member (driver triggering it), only staff
          // edit/delete.
          match /notifications/{notificationId} {
            allow read: if isCompanyStaff(companyId) || isAssignedStopDriver(companyId, routeId, stopId);
            allow create: if isCompanyMember(companyId);
            allow update, delete: if isCompanyStaff(companyId);
          }
        }
      }

      // ── companies/{companyId}/trackingLinks/{linkId} ─────
      // The core of unauthenticated customer tracking: a customer who
      // taps their texted link needs to read this one specific
      // document with no login. `get` by known ID is public; `list`
      // is not. Writes require company staff.
      match /trackingLinks/{linkId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow create, update: if isCompanyMember(companyId);
        allow delete: if isCompanyStaff(companyId);

        // Public-safe live position for the customer tracking view -
        // a location only, never the driver's name/phone. Staff/system
        // write it; anyone with the link can read it. (App-side: this
        // path isn't populated yet - see the TODO in CustomerTrackingView.swift.)
        match /location/{locId} {
          allow get: if true;
          allow write: if isCompanyMember(companyId);
        }
      }

      // ── companies/{companyId}/driverReports/{driverId}/reports/{reportId} ─
      // End-of-shift reports. Any signed-in company member can submit
      // one (same driver-identity caveat as stops above); only staff
      // can read the roll-up or edit/delete after submission.
      match /driverReports/{driverId}/reports/{reportId} {
        allow read: if isCompanyStaff(companyId);
        allow create: if isCompanyMember(companyId);
        allow update, delete: if isCompanyStaff(companyId);
      }

      // ── companies/{companyId}/feedback/{id} ──────────────
      // Beta "Report Issue" submissions. Any company member can
      // submit (owner, manager, or driver reporting what they hit
      // during testing); read is platform-admin only for now - this
      // is the developer's own triage list, not something a company
      // owner needs a dashboard for yet.
      match /feedback/{feedbackId} {
        allow create: if isCompanyMember(companyId);
        allow read: if isPlatformAdmin();
      }
    }

    // Explicitly block cross-company collectionGroup queries - without
    // this, a query like db.collectionGroup("drivers") could return
    // every company's drivers at once even though single-document
    // reads are properly scoped above. Firestore requires an explicit
    // rule for collection-group access; omitting it here means denied.

    // ── invites/{contactValue} — company employee onboarding ─
    // Top-level, not nested under a company, because a not-yet-signed-
    // in person needs to look themselves up by phone/email alone,
    // before they know any companyId. The document ID IS the
    // normalized contact value, so lookup is always a direct get by
    // the requester's own auth token identity - never a query - which
    // is what keeps this safe: nobody can list or browse other
    // people's invites, only ever fetch the one addressed to them.
    //
    // Create/cancel: the company's OWNER only (not manager) - matches
    // "Company Owner can invite/cancel" exactly, nothing broader.
    // Accept: the invited person themselves, matched by their own
    // verified email/phone - they can never create an invite, only
    // consume one already sent to them, and can only ever move it to
    // "accepted", never assign themselves a company/role directly
    // (that happens via the separate, owner-gated users/{uid} update
    // rule above, triggered by the app after a successful accept).

    match /invites/{contactValue} {
      allow read: if isInviteRecipient(contactValue) || isCompanyOwnerRole(resource.data.companyId);

      allow create: if isCompanyOwnerRole(request.resource.data.companyId)
                    && request.resource.data.status == 'pending';

      allow update: if isSignedIn() && (
                         (isCompanyOwnerRole(resource.data.companyId)
                           && request.resource.data.companyId == resource.data.companyId)
                         ||
                         (isInviteRecipient(contactValue)
                           && request.resource.data.status == 'accepted'
                           && request.resource.data.companyId == resource.data.companyId
                           && request.resource.data.role == resource.data.role)
                       );

      allow delete: if isCompanyOwnerRole(resource.data.companyId);
    }

    // Listing an owner's pending invites is a query (whereField
    // companyId/status), not a get-by-ID - Firestore evaluates list
    // rules per matched document the same way as get, so the read
    // rule above already covers it via isCompanyOwnerRole.

    // entitlements/{uid} (legacy, individual-user, self-writable
    // subscription sync) has been removed - AppEntitlements and
    // SubscriptionSyncService, the only code that ever read or wrote
    // it, were deleted. The real, company-level subscription tier
    // lives on companies/{companyId}.subscriptionTier, writable only
    // by a platform admin or the syncSubscriptionEntitlement Cloud
    // Function's Admin SDK access - never by a client write to its
    // own document, which is exactly the hole this collection was.

    // ── Everything else: locked ──────────────────────────────
    // No implicit access to anything not explicitly listed above.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
